{
  "expo": {
    "name": "ZAIBASE 資格対策",
    "slug": "zaibase-shikaku",
    "scheme": "zaibase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaysonaman.zaibase",
      "infoPlist": {
        "CFBundleDisplayName": "ZAIBASE資格対策"
      }
    },
    "android": {
      "package": "com.jaysonaman.zaibase",
      "adaptiveIcon": {
        "backgroundColor": "#101A38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
{
  "expo": {
    "name": "QualiZ",
    "slug": "qualiz",
    "scheme": "qualiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaysonaman.qualiz",
      "infoPlist": {
        "CFBundleDisplayName": "QualiZ",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jaysonaman.qualiz",
      "adaptiveIcon": {
        "backgroundColor": "#101A38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92fb2403-aebb-4e67-beaf-58bafbcf3179"
      }
    },
    "owner": "masaya.nanjo"
  }
}

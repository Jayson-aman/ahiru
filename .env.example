# RevenueCat — https://app.revenuecat.com → Project → API keys
EXPO_PUBLIC_RC_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat Web Billing — https://app.revenuecat.com → Project → Web → QualiZ (Stripe) →
# Purchase tracking タブ内の「Public API Key」を開いて値をコピー。
# Stripe連携で発行されるキーは strp_ で始まる（ブラウザに配信される公開鍵）。
EXPO_PUBLIC_RC_API_KEY_WEB=strp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat — https://app.revenuecat.com → Project → API keys
EXPO_PUBLIC_RC_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat Web Billing の公開キー（ブラウザに配信される公開鍵）
# https://app.revenuecat.com → Project settings → API keys →
#   ★「QualiZ (RevenueCat Billing)」の公開キー（rcb_ で始まる）
#
# 「QualiZ (Stripe)」のキー（strp_）ではない。@revenuecat/purchases-js の
# Package が持つ商品は rcBillingProduct（非推奨）と webBillingProduct だけで、
# Stripeストアの商品を読むフィールドが型定義に存在しないため、strp_ を入れると
# どの資格でも購入できない。詳細は docs/REVENUECAT_AUDIT.md の 4b。
EXPO_PUBLIC_RC_API_KEY_WEB=rcb_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
